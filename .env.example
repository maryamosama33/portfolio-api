# Copy to .env and fill in. docker-compose overrides the MongoDB/Redis URLs with service names.

# --- Auth (required) ---
# Generate a secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ADMIN_USERNAME=admin
# Generate a hash:    uv run python -m scripts.hash_password
# Wrap it in single quotes: bcrypt hashes contain `$`.
ADMIN_PASSWORD_HASH=''

# --- AI providers (required for job matching, the analyzer and chatbot search) ---
GEMINI_API_KEY=
TAVILY_API_KEY=

# --- Storage (defaults suit a local run) ---
MONGO_URI=mongodb://localhost:27017
DB_NAME=portfolio
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Job search tuning (optional) ---
JOB_SEARCH_LOCATION=Egypt
JOB_SEARCH_DOMAINS=linkedin.com,indeed.com,glassdoor.com,wuzzuf.net,wellfound.com
# GEMINI_MODEL=gemini-2.5-flash
# LOG_LEVEL=INFO
